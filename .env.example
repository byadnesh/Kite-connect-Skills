# Copy to .env (git-ignored) and load it in your shell. Never commit real values.
# UNOFFICIAL project — not affiliated with Zerodha.

# From https://developers.kite.trade → your app
KITE_API_KEY=
# Only needed by scripts/login.py to exchange the request_token
KITE_API_SECRET=
# Optional: set after login instead of using the cached ~/.kite-skills/session.json
KITE_ACCESS_TOKEN=

# Optional guardrails / settings
KITE_MAX_ORDER_VALUE=50000
# Extra exchange holidays (YYYY-MM-DD, comma-separated) for market-hours checks
KITE_HOLIDAYS=
# Where caches, journal and session live (default ~/.kite-skills)
KITE_SKILLS_HOME=
